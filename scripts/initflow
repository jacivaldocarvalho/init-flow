#!/usr/bin/env bash

# Init Flow
# Copyright (c) 2026 Jacivaldo Carvalho
# Licensed under the MIT License.

set -euo pipefail

VERSION="0.2.0"
ORIGINAL_DIR="$PWD"

log_info() {
    printf '[INFO] %s\n' "$1"
}

log_success() {
    printf '[SUCCESS] %s\n' "$1"
}

log_error() {
    printf '[ERROR] %s\n' "$1" >&2
}

show_help() {
    cat <<EOF
Init Flow - Project Initialization CLI

Usage:
  initflow <command> [arguments]

Commands:
  create <name> [options]  Create a local project and optional GitHub repository

Options:
  -h, --help       Show this help message
  -v, --version    Show CLI version
  --private        Create a private GitHub repository (default: public)
  --readme         Generate README.md
  --description TEXT  Set the GitHub repository description
  --local          Skip GitHub integration
  --path DIRECTORY  Set the projects base directory
  --no-editor      Skip Visual Studio Code launch
  --dry-run        Display planned operations without executing them

Examples:
  initflow create my-project
  initflow --help
  initflow --version

Documentation:
  https://github.com/jacivaldocarvalho/init-flow
EOF
}

check_dependency() {
    local dependency="$1"

    if ! command -v "$dependency" >/dev/null 2>&1; then
        log_error "Required dependency not found: $dependency"
        return 1
    fi
}

validate_project_name() {
    local name="$1"

    if [[ ! "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
        log_error "Invalid project name: $name"
        log_error "Use only letters, numbers, dots, underscores, and hyphens."
        return 1
    fi

    if [[ "$name" == *..* ]]; then
        log_error "Project names cannot contain consecutive dots."
        return 1
    fi
}

check_dependencies() {
    log_info "Checking dependencies..."

    check_dependency git
    if [[ "$LOCAL" == false ]]; then check_dependency gh; fi
    if [[ "$NO_EDITOR" == false ]]; then check_dependency code; fi
}

parse_create_args() {
    local option
    local -A seen=()
    PROJECT_NAME=""
    PRIVATE=false README=false LOCAL=false NO_EDITOR=false DRY_RUN=false
    DESCRIPTION="" CUSTOM_PATH=""
    while (($#)); do
        option="$1"
        case "$option" in
            --private|--readme|--local|--no-editor|--dry-run|--description|--path)
                if [[ -n "${seen[$option]:-}" ]]; then
                    log_error "Duplicate option: $option"; return 1
                fi
                seen[$option]=1
                case "$option" in
                    --private) PRIVATE=true ;;
                    --readme) README=true ;;
                    --local) LOCAL=true ;;
                    --no-editor) NO_EDITOR=true ;;
                    --dry-run) DRY_RUN=true ;;
                    --description|--path)
                        if (($# < 2)) || [[ -z "$2" || "$2" == --* ]]; then
                            log_error "Missing value for $option"; return 1
                        fi
                        if [[ "$option" == --description ]]; then DESCRIPTION="$2"; else CUSTOM_PATH="$2"; fi
                        shift ;;
                esac ;;
            --*) log_error "Unknown option: $option"; return 1 ;;
            *)
                if [[ -n "$PROJECT_NAME" ]]; then log_error "Unexpected argument: $option"; return 1; fi
                PROJECT_NAME="$option" ;;
        esac
        shift
    done
    if [[ -z "$PROJECT_NAME" ]]; then log_error "Missing project name."; return 1; fi
    validate_project_name "$PROJECT_NAME" || return 1
    if [[ "$LOCAL" == true && ( "$PRIVATE" == true || -n "${seen[--description]:-}" ) ]]; then
        log_error "--local cannot be combined with --private or --description."; return 1
    fi
    PROJECTS_DIR="${CUSTOM_PATH:-${INITFLOW_PROJECTS_DIR:-${HOME}/projects}}"
    if [[ "$PROJECTS_DIR" != /* ]]; then PROJECTS_DIR="${ORIGINAL_DIR}/${PROJECTS_DIR}"; fi
}

check_github_auth() {
    log_info "Checking GitHub authentication..."

    if ! gh auth status >/dev/null 2>&1; then
        log_error "GitHub authentication failed."
        log_error "Run: gh auth login"
        return 1
    fi
}

create_project() {
    local name="$PROJECT_NAME"
    local project_dir="${PROJECTS_DIR}/${name}"
    local github_user
    local repository_url

    if [[ -e "$project_dir" || -L "$project_dir" ]]; then
        log_error "Local project directory already exists: $project_dir"
        return 1
    fi

    if [[ "$DRY_RUN" == true ]]; then
        printf 'Dry run: mkdir %s; git init -b main\n' "$project_dir"
        if [[ "$README" == true ]]; then printf 'Dry run: generate README.md\n'; fi
        if [[ "$LOCAL" == false ]]; then
            printf 'Dry run: create %s GitHub repository' "$(if [[ "$PRIVATE" == true ]]; then printf private; else printf public; fi)"
            if [[ -n "$DESCRIPTION" ]]; then printf ' with description: %s' "$DESCRIPTION"; fi
            printf '\nRemote availability has not been verified.\n'
        fi
        if [[ "$NO_EDITOR" == false ]]; then printf 'Dry run: open Visual Studio Code\n'; fi
        return 0
    fi

    check_dependencies
    if [[ "$LOCAL" == false ]]; then
        check_github_auth

        github_user="$(gh api user --jq '.login')"

        if [[ -z "$github_user" ]]; then
        log_error "Unable to identify the authenticated GitHub user."
        return 1
        fi
    fi

    log_info "Checking existing projects..."

    if [[ "$LOCAL" == false ]]; then
    local api_response
    local api_exit_code=0
    local http_status

    # Capture the GitHub API response without masking command failures.
    api_response="$(
        gh api -i "repos/${github_user}/${name}" 2>/dev/null
    )" || api_exit_code=$?

    http_status="$(
        printf '%s\n' "$api_response" |
            awk 'toupper($1) ~ /^HTTP\// { status=$2 } END { print status }'
    )"

    case "$http_status" in
        200)
            log_error "GitHub repository already exists: ${github_user}/${name}"
            return 1
            ;;
        404)
            # A 404 response is expected for a repository that does not exist.
            ;;
        401|403)
            log_error "GitHub API access denied (HTTP $http_status)."
            return 1
            ;;
        *)
            log_error "Unable to verify GitHub repository availability."
            log_error "HTTP status: ${http_status:-unknown}"
            log_error "GitHub CLI exit code: $api_exit_code"
            return 1
            ;;
    esac
    fi

    log_info "Creating project directory..."
    mkdir -p "$PROJECTS_DIR"
    mkdir "$project_dir"

    if [[ "$README" == true ]]; then
        (set -C; printf '# %s\n' "$name" > "${project_dir}/README.md")
    fi

    log_info "Initializing Git..."
    git -C "$project_dir" init -b main

    if [[ "$LOCAL" == false ]]; then
    log_info "Creating GitHub repository..."

    local -a gh_args=(repo create "${github_user}/${name}")
    if [[ "$PRIVATE" == true ]]; then gh_args+=(--private); else gh_args+=(--public); fi
    if [[ -n "$DESCRIPTION" ]]; then gh_args+=(--description "$DESCRIPTION"); fi
    gh_args+=(--source=. --remote=origin)

    if ! (
        cd "$project_dir"
        gh "${gh_args[@]}"
    ); then
        log_error "GitHub repository creation failed."
        log_error "Local directory preserved: $project_dir"
        return 1
    fi

    repository_url="https://github.com/${github_user}/${name}"
    fi

    log_success "Project created successfully!"
    printf '\n'
    printf 'Project: %s\n' "$name"
    printf 'Directory: %s\n' "$project_dir"
    if [[ "$LOCAL" == false ]]; then printf 'Repository: %s\n' "$repository_url"; fi
    printf 'Branch: main\n'
    printf '\n'

    if [[ "$NO_EDITOR" == true ]]; then return 0; fi
    log_info "Opening Visual Studio Code..."

    if ! code "$project_dir"; then
        log_error "Unable to open Visual Studio Code."
        log_info "Your project was created successfully."
    fi
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 1
    fi

    case "$1" in
        create)
            shift
            parse_create_args "$@"
            create_project
            ;;
        -h|--help)
            show_help
            ;;
        -v|--version)
            printf 'Init Flow v%s\n' "$VERSION"
            ;;
        *)
            log_error "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
